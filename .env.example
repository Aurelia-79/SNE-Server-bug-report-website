ENVIRONMENT=production
HOST=0.0.0.0
PORT=17250

# Must be changed before public deployment. Use at least 32 random characters.
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 0.0.0.0 exposes the service on the local network. For a public domain, replace * with that domain.
CORS_ORIGINS=*
TRUSTED_HOSTS=*

ENABLE_DOCS=0
SEED_DEMO_DATA=0

# SQLite is the default production-local database. For MySQL, replace DATABASE_URL.
DATABASE_URL=sqlite:///data/app.db
UPLOAD_DIR=data/uploads
DEFAULT_PASS_SCORE=60
MAX_UPLOAD_SIZE_MB=50
GAME_BRIDGE_BASE_URL=http://127.0.0.1:17251
GAME_BRIDGE_TOKEN=change-this-bridge-token
GAME_BRIDGE_TIMEOUT_SECONDS=5

# Created only when the username does not already exist.
BOOTSTRAP_SUPER_ADMIN_USERNAME=superadmin
BOOTSTRAP_SUPER_ADMIN_PASSWORD=change-this-superadmin-password
BOOTSTRAP_SUPER_ADMIN_DISPLAY_NAME=系统超管
MAIL_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
MAIL_FROM=
MAIL_ADMIN_REPLY_TO=
MAIL_TIMEOUT_SECONDS=10

# 工单邮件通知说明:
# - MAIL_ENABLED=1 后才会发送邮件
# - SMTP_* 需要填真实 SMTP 服务
# - MAIL_FROM 默认使用 SMTP_USERNAME
